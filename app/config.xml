<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tizen widget manifest for Clean Hub.
  - Package id is exactly 10 letters/digits; the app id is <package>.<name>.
    apps.js (selfIdPrefix) and scripts/tv.py rely on these values.
  - required_version must not exceed the TV's Tizen version (6.5 on 2022 sets).
  - Only public-level privileges, so a plain Tizen developer certificate can
    sign it: application.launch opens other apps; application.info covers
    getAppsInfo's extra fields; tv.window switches the TV to an HDMI input;
    tv.inputdevice lets it take remote keys Samsung otherwise keeps (the
    Netflix button, while Clean Hub is on screen);
    internet lets the Fire TV service reach the Fire TV Stick on the home
    network, and the Home watcher ask the TV's own REST and AirPlay
    endpoints on 127.0.0.1.
  - The Home watcher starts when the TV does (on-boot), so the Home button
    works before Clean Hub has been opened.
  - The page has no <access> element, so it makes no network requests. Only
    the background services do: service/firetv.js, only to the paired Fire TV
    Stick when a Fire TV app is opened from Home; service/home.js, only to
    the TV itself (127.0.0.1).
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://cleanhub.local/launcher" version="0.1.0" viewmodes="maximized">
  <tizen:application id="CleanHub01.Launcher" package="CleanHub01" required_version="3.0"/>
  <tizen:profile name="tv-samsung"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>Clean Hub</name>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:service id="CleanHub01.FireTv" type="ui">
    <tizen:content src="service/firetv.js"/>
    <tizen:name>Clean Hub Fire TV</tizen:name>
    <tizen:description>Opens apps on the Fire TV Stick</tizen:description>
  </tizen:service>
  <tizen:service id="CleanHub01.Home" type="ui" on-boot="true">
    <tizen:content src="service/home.js"/>
    <tizen:name>Clean Hub Home</tizen:name>
    <tizen:description>Brings Clean Hub back when the Home button opens the Smart Hub</tizen:description>
  </tizen:service>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
